      "beats": [
        {
          "beat_id": 1,
          "description": "父亲坚持亲自送行，与脚夫讲价钱、叮嘱路上小心",
          "goal": "父亲想尽到做父亲的心意，儿子却觉得多余。",
          "is_key_event": true,
          "evidence_refs": [
            {
              "source_type": "original_text",
              "excerpt": "他再三嘱咐茶房，甚是仔细。他终于决定还是自己送我去。",
              "paragraph_index": 2,
              "char_start": 0,
              "char_end": 25
            }
          ],
          "dialogue": [
            {
              "schema_version": "3.4.0",
              "speaker": "父亲",
              "text": "我买几个橘子去。你就在此地，不要走动。",
              "stage_direction": "把橘子堆在儿子的皮大衣上"
            }
          ]
        },
        {
          "beat_id": 2,
          "description": "父亲穿过铁道爬上月台为儿子买橘子",
          "goal": "父亲用行动照顾儿子，不肯让儿子代劳。",
          "is_key_event": true,
          "evidence_refs": [
            {
              "source_type": "original_text",
              "excerpt": "我看见他戴着黑布小帽，穿着黑布大马褂，深青布棉袍，蹒跚地走到铁道边，慢慢探身下去。",
              "paragraph_index": 5,
              "char_start": 10,
              "char_end": 48
            }
          ]
        },
        {
          "beat_id": 3,
          "description": "父子分别，背影混入来来往往的人群",
          "goal": "离别在即，父子都不擅长表达不舍。",
          "is_key_event": true,
          "evidence_refs": [
            {
              "source_type": "original_text",
              "excerpt": "等他的背影混入来来往往的人里，再找不着了，我便进来坐下，我的眼泪又来了。",
              "paragraph_index": 6,
              "char_start": 0,
              "char_end": 36
            }
          ]
        }
      ],

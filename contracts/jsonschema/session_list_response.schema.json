{
  "$defs": {
    "SessionSummary": {
      "additionalProperties": false,
      "description": "「我的游戏」列表项：会话元数据 + 引用剧本名。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "script_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script Id"
        },
        "script_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script Name"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "player_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Player Role"
        },
        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "session_id",
        "stage",
        "status"
      ],
      "title": "SessionSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "「我的游戏」列表（当前用户自己的剧情世界）。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SessionSummary"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "title": "SessionListResponse",
  "type": "object"
}

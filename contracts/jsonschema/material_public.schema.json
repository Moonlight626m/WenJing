{
  "additionalProperties": false,
  "description": "素材对外投影（不含原文全文，避免大 payload）。",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "integer"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "char_count": {
      "minimum": 1,
      "title": "Char Count",
      "type": "integer"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    }
  },
  "required": [
    "id",
    "content_hash",
    "char_count"
  ],
  "title": "MaterialPublic",
  "type": "object"
}

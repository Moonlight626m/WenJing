{
  "$defs": {
    "UserRole": {
      "description": "账号角色（ADR-0002）：平台超管 / 教师 / 学生。",
      "enum": [
        "super_admin",
        "teacher",
        "student"
      ],
      "title": "UserRole",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "当前用户对外投影（绝不包含 password_hash）。",
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "org_id": {
      "format": "uuid",
      "title": "Org Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/UserRole"
    },
    "email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Email"
    },
    "phone": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phone"
    },
    "nickname": {
      "title": "Nickname",
      "type": "string"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    }
  },
  "required": [
    "id",
    "org_id",
    "role",
    "nickname"
  ],
  "title": "UserPublic",
  "type": "object"
}

{
  "$defs": {
    "DoubterEvent": {
      "additionalProperties": false,
      "description": "doubter 裁决记录：打回时带逐条问题（教师端可见）。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/GenerationNode"
        },
        "verdict": {
          "pattern": "^(pass|reject)$",
          "title": "Verdict",
          "type": "string"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "round": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        }
      },
      "required": [
        "node",
        "verdict"
      ],
      "title": "DoubterEvent",
      "type": "object"
    },
    "GenerationNode": {
      "description": "workflow 节点（与 generation/workflow/graph.py 的图拓扑对齐）。",
      "enum": [
        "collect_materials",
        "verify_materials",
        "divide_events",
        "design_characters",
        "write_script",
        "final_audit"
      ],
      "title": "GenerationNode",
      "type": "string"
    },
    "GenerationNodeStatus": {
      "description": "节点级状态：rejected 表示被 doubter 打回（上游会重做）。",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "rejected",
        "failed"
      ],
      "title": "GenerationNodeStatus",
      "type": "string"
    },
    "GenerationStatus": {
      "description": "一次生成尝试的总体状态。\n\nawaiting_review 为教师闸门预留（#34）：流水线停在闸门等审阅。",
      "enum": [
        "idle",
        "running",
        "awaiting_review",
        "succeeded",
        "failed"
      ],
      "title": "GenerationStatus",
      "type": "string"
    },
    "NodeProgress": {
      "additionalProperties": false,
      "description": "单个 workflow 节点的进度投影。",
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/GenerationNode"
        },
        "status": {
          "$ref": "#/$defs/GenerationNodeStatus"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "node",
        "status"
      ],
      "title": "NodeProgress",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "生成进度：长时间生成过程不是黑盒（进度由 script_generations 落库）。",
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GenerationStatus"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeProgress"
      },
      "title": "Nodes",
      "type": "array"
    },
    "doubter_events": {
      "items": {
        "$ref": "#/$defs/DoubterEvent"
      },
      "title": "Doubter Events",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "status"
  ],
  "title": "GenerationProgress",
  "type": "object"
}

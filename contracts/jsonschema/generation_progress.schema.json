{
  "$defs": {
    "DoubterEvent": {
      "additionalProperties": false,
      "description": "doubter 裁决记录：打回时带逐条问题（教师端可见）。\n\n`issues` 两种形状并存：结构化 `DoubterIssue`（doubter 模型产出）与纯字符串\n（确定性规则校验，如 `validate_replay` 的结构问题——它们没有 severity/\ncategory/field）。历史落库的 progress 是 `list[str]`，union 保证旧行仍能校验。\n展示形状交给前端：string 走「规则校验」样式，模型走问题卡片。",
      "properties": {
        "schema_version": {
          "default": "3.5.0",
          "title": "Schema Version",
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/GenerationNode"
        },
        "verdict": {
          "pattern": "^(pass|reject)$",
          "title": "Verdict",
          "type": "string"
        },
        "issues": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/DoubterIssue"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Issues",
          "type": "array"
        },
        "round": {
          "default": 1,
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        }
      },
      "required": [
        "node",
        "verdict"
      ],
      "title": "DoubterEvent",
      "type": "object"
    },
    "DoubterIssue": {
      "additionalProperties": false,
      "description": "doubter 单条问题：可定位、可执行（Self-Refine 心智，spec 裁决）。\n\n- field：产物中的字段定位（如 scenes[2].beats[4].description）；\n- severity：must-fix ≥1 条即 reject；nice-to-fix 不触发打回；\n- evidence：判定依据（原文依据摘要中的对应条目/摘录）。",
      "properties": {
        "schema_version": {
          "default": "3.5.0",
          "title": "Schema Version",
          "type": "string"
        },
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        },
        "category": {
          "enum": [
            "人物事实",
            "事件顺序",
            "编造情节",
            "篡改关键事实"
          ],
          "title": "Category",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "severity": {
          "enum": [
            "must_fix",
            "nice_to_fix"
          ],
          "title": "Severity",
          "type": "string"
        },
        "suggestion": {
          "default": "",
          "title": "Suggestion",
          "type": "string"
        }
      },
      "required": [
        "field",
        "category",
        "severity"
      ],
      "title": "DoubterIssue",
      "type": "object"
    },
    "GenerationNode": {
      "description": "workflow 节点（与 generation/workflow/graph.py 的图拓扑对齐）。",
      "enum": [
        "collect_materials",
        "verify_materials",
        "divide_events",
        "design_characters",
        "write_script",
        "write_dialogue",
        "final_audit",
        "design_exploration",
        "design_assets"
      ],
      "title": "GenerationNode",
      "type": "string"
    },
    "GenerationNodeStatus": {
      "description": "节点级状态：rejected 表示被 doubter 打回（上游会重做）。",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "rejected",
        "failed"
      ],
      "title": "GenerationNodeStatus",
      "type": "string"
    },
    "GenerationStatus": {
      "description": "一次生成尝试的总体状态。\n\nawaiting_review 为教师闸门预留（#34）：流水线停在闸门等审阅。",
      "enum": [
        "idle",
        "running",
        "awaiting_review",
        "succeeded",
        "failed"
      ],
      "title": "GenerationStatus",
      "type": "string"
    },
    "NodeProgress": {
      "additionalProperties": false,
      "description": "单个 workflow 节点的进度投影。",
      "properties": {
        "schema_version": {
          "default": "3.5.0",
          "title": "Schema Version",
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/GenerationNode"
        },
        "status": {
          "$ref": "#/$defs/GenerationNodeStatus"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "node",
        "status"
      ],
      "title": "NodeProgress",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "生成进度：长时间生成过程不是黑盒（进度由 script_generations 落库）。",
  "properties": {
    "schema_version": {
      "default": "3.5.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GenerationStatus"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeProgress"
      },
      "title": "Nodes",
      "type": "array"
    },
    "doubter_events": {
      "items": {
        "$ref": "#/$defs/DoubterEvent"
      },
      "title": "Doubter Events",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "status"
  ],
  "title": "GenerationProgress",
  "type": "object"
}

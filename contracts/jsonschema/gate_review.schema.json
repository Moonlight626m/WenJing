{
  "$defs": {
    "Appearance": {
      "additionalProperties": false,
      "description": "结构化外貌要素（文生图锚定）：只写原文可推断内容。\n\n未交代处如实填「原文未交代」，由媒体层渲染为时代中性词——\n严禁编造原文外的辨识性细节（具体五官、时代错位服饰）。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "face": {
          "default": "",
          "title": "Face",
          "type": "string"
        },
        "hair": {
          "default": "",
          "title": "Hair",
          "type": "string"
        },
        "clothing": {
          "default": "",
          "title": "Clothing",
          "type": "string"
        },
        "accessories": {
          "default": "",
          "title": "Accessories",
          "type": "string"
        },
        "build": {
          "default": "",
          "title": "Build",
          "type": "string"
        }
      },
      "title": "Appearance",
      "type": "object"
    },
    "AssetCredit": {
      "additionalProperties": false,
      "description": "素材署名/许可元数据（ADR-0005 §6）：供教师端展示与学生端折叠署名。\n\n默认仅采用免署名许可（CC0/PD）；采用需署名许可时向最终用户展示。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "author": {
          "default": "",
          "title": "Author",
          "type": "string"
        },
        "license": {
          "default": "",
          "title": "License",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "title": "Source Url",
          "type": "string"
        },
        "license_url": {
          "default": "",
          "title": "License Url",
          "type": "string"
        }
      },
      "title": "AssetCredit",
      "type": "object"
    },
    "AssetRef": {
      "additionalProperties": false,
      "description": "稳定资产引用（ADR-0005 §3）。\n\n只放稳定 id/kind/status；字节与 URL（含 `object_key`）不进契约——访问经鉴权\n端点签发短时效预签名 URL（#42）。\n\n`scene_montage`（方案 branch-montage-dm）是**完整场面图**：背景+在场人物+\n行为一图的插画（推翻 ADR-0005 §1「游玩内不显示人物」需随 ADR 修订走）；\n`background` 保留给旧脚本与纯空镜背景。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "asset_id": {
          "format": "uuid",
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "background",
            "avatar",
            "fullbody",
            "scene_montage"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "status"
      ],
      "title": "AssetRef",
      "type": "object"
    },
    "Beat": {
      "additionalProperties": false,
      "description": "单场景内的情节点；关键 beat 带 evidence_refs（原文证据）。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "beat_id": {
          "title": "Beat Id",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "is_key_event": {
          "default": false,
          "title": "Is Key Event",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "discriminator": {
              "mapping": {
                "original_text": "#/$defs/OriginalEvidence",
                "web": "#/$defs/WebEvidence"
              },
              "propertyName": "source_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/OriginalEvidence"
              },
              {
                "$ref": "#/$defs/WebEvidence"
              }
            ]
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "beat_id",
        "description"
      ],
      "title": "Beat",
      "type": "object"
    },
    "BeatDraft": {
      "additionalProperties": false,
      "description": "划分草稿的单个节拍：key_event_order 指向原文关键事件序号。",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "is_key_event": {
          "default": false,
          "title": "Is Key Event",
          "type": "boolean"
        },
        "key_event_order": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Event Order"
        }
      },
      "required": [
        "description"
      ],
      "title": "BeatDraft",
      "type": "object"
    },
    "BranchScene": {
      "additionalProperties": false,
      "description": "伪分支场景（珊瑚形结构）：挂在主干场景介入点上的替代过场。\n\n分支播放完并回主干下一场，结局固定；分支 beat 一律非关键事件\n（不进 total_beats、不动主 beat_cursor），不得包含 must_not_change\n关键事件、不得改变课文结局。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "branch_id": {
          "pattern": "^b[1-9][0-9]*$",
          "title": "Branch Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "visual_notes": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualNotes"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "anchor_beat_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Beat Id"
        },
        "background_asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "background_credit": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetCredit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "branch_id",
        "label",
        "title",
        "beats"
      ],
      "title": "BranchScene",
      "type": "object"
    },
    "BranchSpec": {
      "additionalProperties": false,
      "description": "划分草稿的分支规格（divide_events v3 产出，write_script 补写成 BranchScene）。\n\n只给规格不给成文：trigger_option 是该介入点的「典型玩家选择」一句话，\n不预设玩家必须这么说；value_turn 是分支内的 A→B 微转折（不得是主线\n关键转折，主线转折受 must_not_change 保护）。",
      "properties": {
        "branch_id": {
          "pattern": "^b[1-9][0-9]*$",
          "title": "Branch Id",
          "type": "string"
        },
        "trigger_option": {
          "minLength": 1,
          "title": "Trigger Option",
          "type": "string"
        },
        "value_turn": {
          "minLength": 1,
          "title": "Value Turn",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "beat_outline": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Beat Outline",
          "type": "array"
        }
      },
      "required": [
        "branch_id",
        "trigger_option",
        "value_turn",
        "beat_outline"
      ],
      "title": "BranchSpec",
      "type": "object"
    },
    "CharacterNote": {
      "additionalProperties": false,
      "description": "素材集里对单个人物的结论。",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "name",
        "note"
      ],
      "title": "CharacterNote",
      "type": "object"
    },
    "CharacterProfile": {
      "additionalProperties": false,
      "description": "单个角色的设定（身份/背景/性格/语言风格），角色 Agent identity 的来源。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "public_background": {
          "title": "Public Background",
          "type": "string"
        },
        "appearance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Appearance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "personality_traits": {
          "items": {
            "$ref": "#/$defs/CharacterTrait"
          },
          "title": "Personality Traits",
          "type": "array"
        },
        "speech_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeechStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "knowledge_boundary": {
          "$ref": "#/$defs/KnowledgeBoundary"
        },
        "is_player_playable": {
          "$ref": "#/$defs/Playability"
        },
        "avatar_asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fullbody_asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "avatar_credit": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetCredit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fullbody_credit": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetCredit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "public_background"
      ],
      "title": "CharacterProfile",
      "type": "object"
    },
    "CharacterTrait": {
      "additionalProperties": false,
      "description": "性格标签：标签 + 原文证据 + 行为化描述（show don't tell，spec 裁决）。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "behavior": {
          "default": "",
          "title": "Behavior",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "CharacterTrait",
      "type": "object"
    },
    "ClaimRef": {
      "additionalProperties": false,
      "description": "单条论断的溯源登记（素材集 claims 集中登记表，spec 裁决）。\n\n- target：论断在产物中的定位（字段路径或论断短语）；\n- source_type + confidence 是「来源 × 可信度」两维标注；\n- evidence_ref 指向支持该论断的原文区间或网络来源（推断类可为原文依据）。",
      "properties": {
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/EvidenceSourceType"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "original_text": "#/$defs/OriginalEvidence",
                  "web": "#/$defs/WebEvidence"
                },
                "propertyName": "source_type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/OriginalEvidence"
                },
                {
                  "$ref": "#/$defs/WebEvidence"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "target",
        "source_type",
        "confidence"
      ],
      "title": "ClaimRef",
      "type": "object"
    },
    "ConfidenceLevel": {
      "description": "论断可信度分级：素材考证与 doubter 审核共用（spec 裁决）。",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "EventDivisionDraft": {
      "additionalProperties": false,
      "description": "事件/情景划分草稿：beats 结构先于剧本书写（#31 深化）。",
      "properties": {
        "scenes": {
          "items": {
            "$ref": "#/$defs/SceneDraft"
          },
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        }
      },
      "required": [
        "scenes"
      ],
      "title": "EventDivisionDraft",
      "type": "object"
    },
    "EvidenceSourceType": {
      "description": "证据来源类型：原文 / 推断 / 网络补充。",
      "enum": [
        "original_text",
        "inference",
        "web"
      ],
      "title": "EvidenceSourceType",
      "type": "string"
    },
    "InteractionPoint": {
      "additionalProperties": false,
      "description": "场景末尾的玩家介入点（drama manager 心智，spec 裁决）。\n\n为角色扮演运行时预留玩家介入空间：关键事件不可被介入改变，\n介入只发生在 must_not_change 之外的节拍间隙。\n\n定义在 script.py（Scene.interaction_point 引用它；review.py 的 SceneDraft\n也引用）——此前它只存在于 review.py，划分草稿产出后被写入剧本的环节\n丢弃；提升进剧本包是伪分支挂接介入点的前提。",
      "properties": {
        "player_role_hint": {
          "default": "",
          "title": "Player Role Hint",
          "type": "string"
        },
        "what_player_can_do": {
          "minLength": 1,
          "title": "What Player Can Do",
          "type": "string"
        },
        "must_not_change": {
          "items": {
            "type": "integer"
          },
          "title": "Must Not Change",
          "type": "array"
        }
      },
      "required": [
        "what_player_can_do"
      ],
      "title": "InteractionPoint",
      "type": "object"
    },
    "KnowledgeBoundary": {
      "additionalProperties": false,
      "description": "知识边界：角色知道/不知道的事（防 OOC，运行时 persona 引用）。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "knows": {
          "items": {
            "type": "string"
          },
          "title": "Knows",
          "type": "array"
        },
        "not_knows": {
          "items": {
            "type": "string"
          },
          "title": "Not Knows",
          "type": "array"
        }
      },
      "title": "KnowledgeBoundary",
      "type": "object"
    },
    "MaterialDossier": {
      "additionalProperties": false,
      "description": "素材收集节点产物：考证过的背景/时代/人物/情节/教学结论。\n\n- 溯源不散落到每个字段：全部论断集中在 claims 登记表\n  （来源 original_text/inference/web × 可信度 high/medium/low，spec 裁决）；\n- conflicts 登记外部资料与课文的冲突（以原文为准）。",
      "properties": {
        "background": {
          "minLength": 1,
          "title": "Background",
          "type": "string"
        },
        "era_setting": {
          "minLength": 1,
          "title": "Era Setting",
          "type": "string"
        },
        "character_notes": {
          "items": {
            "$ref": "#/$defs/CharacterNote"
          },
          "title": "Character Notes",
          "type": "array"
        },
        "plot_summary": {
          "minLength": 1,
          "title": "Plot Summary",
          "type": "string"
        },
        "teaching_analysis": {
          "items": {
            "type": "string"
          },
          "title": "Teaching Analysis",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimRef"
          },
          "title": "Claims",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/SourceConflict"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "background",
        "era_setting",
        "plot_summary"
      ],
      "title": "MaterialDossier",
      "type": "object"
    },
    "OriginalEvidence": {
      "additionalProperties": false,
      "description": "原文证据：以原文字符区间或段落标识定位。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "const": "original_text",
          "default": "original_text",
          "title": "Source Type",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        }
      },
      "required": [
        "excerpt"
      ],
      "title": "OriginalEvidence",
      "type": "object"
    },
    "Playability": {
      "additionalProperties": false,
      "description": "是否适合玩家扮演：布尔 + 可选理由（不带安全考量，spec 裁决）。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "default": false,
          "title": "Value",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "Playability",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "剧本中的一个场景：参与者 + 有序 beats。",
      "properties": {
        "schema_version": {
          "default": "2.8.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "title": "Beats",
          "type": "array"
        },
        "visual_notes": {
          "anyOf": [
            {
              "$ref": "#/$defs/VisualNotes"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interaction_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/InteractionPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "branches": {
          "items": {
            "$ref": "#/$defs/BranchScene"
          },
          "title": "Branches",
          "type": "array"
        },
        "background_asset": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "background_credit": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetCredit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "scene_id",
        "title"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SceneDraft": {
      "additionalProperties": false,

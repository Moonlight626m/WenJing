{
  "$defs": {
    "Beat": {
      "additionalProperties": false,
      "description": "单场景内的情节点；关键 beat 带 evidence_refs（原文证据）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "beat_id": {
          "title": "Beat Id",
          "type": "integer"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "is_key_event": {
          "default": false,
          "title": "Is Key Event",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "discriminator": {
              "mapping": {
                "original_text": "#/$defs/OriginalEvidence",
                "web": "#/$defs/WebEvidence"
              },
              "propertyName": "source_type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/OriginalEvidence"
              },
              {
                "$ref": "#/$defs/WebEvidence"
              }
            ]
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "beat_id",
        "description"
      ],
      "title": "Beat",
      "type": "object"
    },
    "BeatDraft": {
      "additionalProperties": false,
      "description": "划分草稿的单个节拍：key_event_order 指向原文关键事件序号。",
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "is_key_event": {
          "default": false,
          "title": "Is Key Event",
          "type": "boolean"
        },
        "key_event_order": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Event Order"
        }
      },
      "required": [
        "description"
      ],
      "title": "BeatDraft",
      "type": "object"
    },
    "CharacterNote": {
      "additionalProperties": false,
      "description": "素材集里对单个人物的结论。",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "note": {
          "minLength": 1,
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "name",
        "note"
      ],
      "title": "CharacterNote",
      "type": "object"
    },
    "CharacterProfile": {
      "additionalProperties": false,
      "description": "单个角色的设定（身份/背景/性格/语言风格），角色 Agent identity 的来源。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "public_background": {
          "title": "Public Background",
          "type": "string"
        },
        "personality_traits": {
          "items": {
            "$ref": "#/$defs/CharacterTrait"
          },
          "title": "Personality Traits",
          "type": "array"
        },
        "speech_style": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeechStyle"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "knowledge_boundary": {
          "$ref": "#/$defs/KnowledgeBoundary"
        },
        "is_player_playable": {
          "$ref": "#/$defs/Playability"
        }
      },
      "required": [
        "name",
        "public_background"
      ],
      "title": "CharacterProfile",
      "type": "object"
    },
    "CharacterTrait": {
      "additionalProperties": false,
      "description": "性格标签：标签 + 原文证据 + 行为化描述（show don't tell，spec 裁决）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "evidence": {
          "default": "",
          "title": "Evidence",
          "type": "string"
        },
        "behavior": {
          "default": "",
          "title": "Behavior",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "CharacterTrait",
      "type": "object"
    },
    "ClaimRef": {
      "additionalProperties": false,
      "description": "单条论断的溯源登记（素材集 claims 集中登记表，spec 裁决）。\n\n- target：论断在产物中的定位（字段路径或论断短语）；\n- source_type + confidence 是「来源 × 可信度」两维标注；\n- evidence_ref 指向支持该论断的原文区间或网络来源（推断类可为原文依据）。",
      "properties": {
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "source_type": {
          "$ref": "#/$defs/EvidenceSourceType"
        },
        "confidence": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "original_text": "#/$defs/OriginalEvidence",
                  "web": "#/$defs/WebEvidence"
                },
                "propertyName": "source_type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/OriginalEvidence"
                },
                {
                  "$ref": "#/$defs/WebEvidence"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "target",
        "source_type",
        "confidence"
      ],
      "title": "ClaimRef",
      "type": "object"
    },
    "ConfidenceLevel": {
      "description": "论断可信度分级：素材考证与 doubter 审核共用（spec 裁决）。",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "DoubterEvent": {
      "additionalProperties": false,
      "description": "doubter 裁决记录：打回时带逐条问题（教师端可见）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/GenerationNode"
        },
        "verdict": {
          "pattern": "^(pass|reject)$",
          "title": "Verdict",
          "type": "string"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "round": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        }
      },
      "required": [
        "node",
        "verdict"
      ],
      "title": "DoubterEvent",
      "type": "object"
    },
    "EventDivisionDraft": {
      "additionalProperties": false,
      "description": "事件/情景划分草稿：beats 结构先于剧本书写（#31 深化）。",
      "properties": {
        "scenes": {
          "items": {
            "$ref": "#/$defs/SceneDraft"
          },
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        }
      },
      "required": [
        "scenes"
      ],
      "title": "EventDivisionDraft",
      "type": "object"
    },
    "EvidenceSourceType": {
      "description": "证据来源类型：原文 / 推断 / 网络补充。",
      "enum": [
        "original_text",
        "inference",
        "web"
      ],
      "title": "EvidenceSourceType",
      "type": "string"
    },
    "GateReview": {
      "additionalProperties": false,
      "description": "闸门暂停时给教师看的中间产物快照（按 gate 字段决定哪些字段有意义）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "gate": {
          "enum": [
            "materials",
            "pre_write",
            "final"
          ],
          "title": "Gate",
          "type": "string"
        },
        "dossier": {
          "anyOf": [
            {
              "$ref": "#/$defs/MaterialDossier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/WebEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "division": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventDivisionDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/CharacterProfile"
          },
          "title": "Profiles",
          "type": "array"
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScriptPackage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "gate"
      ],
      "title": "GateReview",
      "type": "object"
    },
    "GenerationNode": {
      "description": "workflow 节点（与 generation/workflow/graph.py 的图拓扑对齐）。",
      "enum": [
        "collect_materials",
        "verify_materials",
        "divide_events",
        "design_characters",
        "write_script",
        "final_audit"
      ],
      "title": "GenerationNode",
      "type": "string"
    },
    "GenerationNodeStatus": {
      "description": "节点级状态：rejected 表示被 doubter 打回（上游会重做）。",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "rejected",
        "failed"
      ],
      "title": "GenerationNodeStatus",
      "type": "string"
    },
    "GenerationProgress": {
      "additionalProperties": false,
      "description": "生成进度：长时间生成过程不是黑盒（进度由 script_generations 落库）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GenerationStatus"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeProgress"
          },
          "title": "Nodes",
          "type": "array"
        },
        "doubter_events": {
          "items": {
            "$ref": "#/$defs/DoubterEvent"
          },
          "title": "Doubter Events",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "status"
      ],
      "title": "GenerationProgress",
      "type": "object"
    },
    "GenerationStatus": {
      "description": "一次生成尝试的总体状态。\n\nawaiting_review 为教师闸门预留（#34）：流水线停在闸门等审阅。",
      "enum": [
        "idle",
        "running",
        "awaiting_review",
        "succeeded",
        "failed"
      ],
      "title": "GenerationStatus",
      "type": "string"
    },
    "InteractionPoint": {
      "additionalProperties": false,
      "description": "场景末尾的玩家介入点（drama manager 心智，spec 裁决）。\n\n为角色扮演运行时预留玩家介入空间：关键事件不可被介入改变，\n介入只发生在 must_not_change 之外的节拍间隙。",
      "properties": {
        "player_role_hint": {
          "default": "",
          "title": "Player Role Hint",
          "type": "string"
        },
        "what_player_can_do": {
          "minLength": 1,
          "title": "What Player Can Do",
          "type": "string"
        },
        "must_not_change": {
          "items": {
            "type": "integer"
          },
          "title": "Must Not Change",
          "type": "array"
        }
      },
      "required": [
        "what_player_can_do"
      ],
      "title": "InteractionPoint",
      "type": "object"
    },
    "KnowledgeBoundary": {
      "additionalProperties": false,
      "description": "知识边界：角色知道/不知道的事（防 OOC，运行时 persona 引用）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "knows": {
          "items": {
            "type": "string"
          },
          "title": "Knows",
          "type": "array"
        },
        "not_knows": {
          "items": {
            "type": "string"
          },
          "title": "Not Knows",
          "type": "array"
        }
      },
      "title": "KnowledgeBoundary",
      "type": "object"
    },
    "MaterialDossier": {
      "additionalProperties": false,
      "description": "素材收集节点产物：考证过的背景/时代/人物/情节/教学结论。\n\n- 溯源不散落到每个字段：全部论断集中在 claims 登记表\n  （来源 original_text/inference/web × 可信度 high/medium/low，spec 裁决）；\n- conflicts 登记外部资料与课文的冲突（以原文为准）。",
      "properties": {
        "background": {
          "minLength": 1,
          "title": "Background",
          "type": "string"
        },
        "era_setting": {
          "minLength": 1,
          "title": "Era Setting",
          "type": "string"
        },
        "character_notes": {
          "items": {
            "$ref": "#/$defs/CharacterNote"
          },
          "title": "Character Notes",
          "type": "array"
        },
        "plot_summary": {
          "minLength": 1,
          "title": "Plot Summary",
          "type": "string"
        },
        "teaching_analysis": {
          "items": {
            "type": "string"
          },
          "title": "Teaching Analysis",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimRef"
          },
          "title": "Claims",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/SourceConflict"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "background",
        "era_setting",
        "plot_summary"
      ],
      "title": "MaterialDossier",
      "type": "object"
    },
    "NodeProgress": {
      "additionalProperties": false,
      "description": "单个 workflow 节点的进度投影。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "node": {
          "$ref": "#/$defs/GenerationNode"
        },
        "status": {
          "$ref": "#/$defs/GenerationNodeStatus"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        }
      },
      "required": [
        "node",
        "status"
      ],
      "title": "NodeProgress",
      "type": "object"
    },
    "OriginalEvidence": {
      "additionalProperties": false,
      "description": "原文证据：以原文字符区间或段落标识定位。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_type": {
          "const": "original_text",
          "default": "original_text",
          "title": "Source Type",
          "type": "string"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "paragraph_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph Index"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        }
      },
      "required": [
        "excerpt"
      ],
      "title": "OriginalEvidence",
      "type": "object"
    },
    "Playability": {
      "additionalProperties": false,
      "description": "是否适合玩家扮演：布尔 + 可选理由（不带安全考量，spec 裁决）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "default": false,
          "title": "Value",
          "type": "boolean"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "Playability",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "剧本中的一个场景：参与者 + 有序 beats。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "title": "Beats",
          "type": "array"
        }
      },
      "required": [
        "scene_id",
        "title"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SceneDraft": {
      "additionalProperties": false,
      "description": "划分草稿的单个场景。interaction_point 可空（无玩家在场/纯过场）。",
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/BeatDraft"
          },
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "interaction_point": {
          "anyOf": [
            {
              "$ref": "#/$defs/InteractionPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "title",
        "beats"
      ],
      "title": "SceneDraft",
      "type": "object"
    },
    "ScriptPackage": {
      "additionalProperties": false,
      "description": "Stage1 生成的完整剧本包（冻结契约，版本化校验后进入游戏）。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "characters": {
          "items": {
            "$ref": "#/$defs/CharacterProfile"
          },
          "minItems": 1,
          "title": "Characters",
          "type": "array"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/Scene"
          },
          "minItems": 1,
          "title": "Scenes",
          "type": "array"
        },
        "teaching_focus": {
          "items": {
            "type": "string"
          },
          "title": "Teaching Focus",
          "type": "array"
        },
        "playable_roles": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Playable Roles",
          "type": "array"
        },
        "stage2_ending_beat_id": {
          "title": "Stage2 Ending Beat Id",
          "type": "integer"
        }
      },
      "required": [
        "title",
        "characters",
        "scenes",
        "playable_roles",
        "stage2_ending_beat_id"
      ],
      "title": "ScriptPackage",
      "type": "object"
    },
    "ScriptStatus": {
      "description": "可复用剧本实体的生命周期（ADR-0002 §3）：草稿→发布→下架。",
      "enum": [
        "draft",
        "published",
        "unpublished"
      ],
      "title": "ScriptStatus",
      "type": "string"
    },
    "ScriptSummary": {
      "additionalProperties": false,
      "description": "剧本列表项/发布结果的轻量投影。",
      "properties": {
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "status": {
          "$ref": "#/$defs/ScriptStatus"
        },
        "visibility": {
          "$ref": "#/$defs/ScriptVisibility"
        },
        "material_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Id"
        },
        "owner_user_id": {
          "format": "uuid",
          "title": "Owner User Id",
          "type": "string"
        },
        "org_id": {
          "format": "uuid",
          "title": "Org Id",

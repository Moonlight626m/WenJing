# 文境 backend 配置示例。复制为 .env 并按需修改。
WENJING_DEBUG=false
WENJING_DATABASE_URL=postgresql+asyncpg://wenjing:wenjing@localhost:5432/wenjing
# 账号会话：HTTPS 部署置 true；seed 测试账号密码
WENJING_AUTH_COOKIE_SECURE=false
WENJING_SEED_PASSWORD=123456
WENJING_LLM_PROVIDER=opencodego
WENJING_LLM_MODEL=glm-5.3-flash
WENJING_LLM_API_KEY=
# 留空则用 provider 默认端点（opencodego: https://opencode.ai/zen/go/v1）
WENJING_LLM_BASE_URL=

# RAG 网络搜索 provider（null=不搜索，生成降级为纯原文；ddgs=DuckDuckGo，免费无需 key）
WENJING_RAG_SEARCH_PROVIDER=null

# --- 媒体与对象存储（ADR-0005 / #40）---
# null=不落盘空实现；s3=S3 兼容（开发 MinIO / 生产 OSS/COS）
WENJING_MEDIA_STORAGE_PROVIDER=s3
# 内网 endpoint（backend 访问）；本地 MinIO 默认 http://localhost:9000
WENJING_MEDIA_STORAGE_ENDPOINT=http://localhost:9000
# 浏览器可达 endpoint（预签名 URL 用）；留空则回退内网 endpoint
WENJING_MEDIA_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
WENJING_MEDIA_STORAGE_BUCKET=wenjing-media
WENJING_MEDIA_STORAGE_REGION=
WENJING_MEDIA_STORAGE_ACCESS_KEY=wenjing
WENJING_MEDIA_STORAGE_SECRET_KEY=wenjing123

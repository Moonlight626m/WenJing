# 文境 backend 配置示例。复制为 .env 并按需修改。
WENJING_DEBUG=false
WENJING_DATABASE_URL=postgresql+asyncpg://wenjing:wenjing@localhost:5432/wenjing
# 账号会话：HTTPS 部署置 true；seed 测试账号密码
WENJING_AUTH_COOKIE_SECURE=false
WENJING_SEED_PASSWORD=123456
WENJING_LLM_PROVIDER=opencodego
WENJING_LLM_MODEL=glm-5.3-flash
WENJING_LLM_API_KEY=
# 留空则用 provider 默认端点。已登记：openai / deepseek /
# opencodego（https://opencode.ai/zen/go/v1）/ ecnu（https://chat.ecnu.edu.cn/open/api/v1）。
# 例：华东师大开放平台（OpenAI 格式）——ecnu-max=DeepSeek-V4-Flash（512K，可开 thinking）、
# ecnu-plus=Qwen3.8-27B（256K）；该平台每用户每模型并发上限 3，建议同时调小
# WENJING_MAX_CONCURRENT_LLM（缺省 5）。
#   WENJING_LLM_PROVIDER=ecnu
#   WENJING_LLM_MODEL=ecnu-plus
WENJING_LLM_BASE_URL=
# 单次 LLM 调用的超时（秒，缺省 240）与超时后的重试次数 / 指数退避基数（缺省 1 次、2 秒）。
# 只重试**超时**：provider 报错（参数错、额度耗尽）重试只是白等。流式的「相邻 chunk
# 空闲上限」另封在 150s，不随这里调大而变长（#65）。
# WENJING_LLM_TIMEOUT_SECONDS=240
# WENJING_LLM_TIMEOUT_RETRIES=1
# WENJING_LLM_RETRY_BACKOFF_SECONDS=2.0

# RAG 网络搜索 provider（null=不搜索，生成降级为纯原文；ddgs=DuckDuckGo，免费无需 key）
WENJING_RAG_SEARCH_PROVIDER=null

# --- 媒体与对象存储（ADR-0005 / #40）---
# null=不落盘空实现；s3=S3 兼容（开发 MinIO / 生产 OSS/COS）
WENJING_MEDIA_STORAGE_PROVIDER=s3
# 内网 endpoint（backend 访问）；本地 MinIO 默认 http://localhost:9000
WENJING_MEDIA_STORAGE_ENDPOINT=http://localhost:9000
# 浏览器可达 endpoint（预签名 URL 用）；留空则回退内网 endpoint
WENJING_MEDIA_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
WENJING_MEDIA_STORAGE_BUCKET=wenjing-media
WENJING_MEDIA_STORAGE_REGION=
WENJING_MEDIA_STORAGE_ACCESS_KEY=wenjing
WENJING_MEDIA_STORAGE_SECRET_KEY=wenjing123

# --- 文生图（ADR-0005 / #46）---
# null=不生成（上层降级为无图/纯文本）；openai=OpenAI 兼容 Images API
WENJING_MEDIA_IMAGE_GEN_PROVIDER=null
# 兼容端点与模型：换厂商只需改这两项（provider 选型仍是 ADR-0005 待定项）
WENJING_MEDIA_IMAGE_GEN_BASE_URL=https://api.openai.com/v1
WENJING_MEDIA_IMAGE_GEN_API_KEY=
WENJING_MEDIA_IMAGE_GEN_MODEL=gpt-image-1
# 多数兼容 provider 认 b64_json/url；gpt-image-1 不接受该参数，留空即不发
WENJING_MEDIA_IMAGE_GEN_RESPONSE_FORMAT=
# 生图比检索慢（单张 10–40s），读超时给足但仍设上界
WENJING_MEDIA_IMAGE_GEN_CONNECT_TIMEOUT=5.0
WENJING_MEDIA_IMAGE_GEN_READ_TIMEOUT=90.0
WENJING_MEDIA_IMAGE_GEN_MAX_BYTES=16777216
WENJING_MEDIA_IMAGE_GEN_MAX_PROMPT_CHARS=1200
# 尺寸模式：preset=按比例映射到 provider 固定档位（gpt-image-1 只认 1024x1024/
# 1536x1024/1024x1536）；exact=直发 WxH（接受任意尺寸的兼容 provider）
WENJING_MEDIA_IMAGE_GEN_SIZE_MODE=preset

# --- 图片检索（ADR-0005 / #44）---
# null=不检索；openverse/wikimedia=开放版权图库（均无需 key，匿名可用）
WENJING_MEDIA_IMAGE_SEARCH_PROVIDER=null
# Openverse 可选访问令牌（匿名限流；配置后走 Bearer 提额）
WENJING_MEDIA_IMAGE_SEARCH_OPENVERSE_TOKEN=
# Wikimedia 要求可识别的 User-Agent
WENJING_MEDIA_IMAGE_SEARCH_USER_AGENT=Wenjing/1.0 media-search
# 下载安全边界（复用 RAG SSRF/DNS 校验）
WENJING_MEDIA_IMAGE_SEARCH_CONNECT_TIMEOUT=5.0
WENJING_MEDIA_IMAGE_SEARCH_READ_TIMEOUT=10.0
WENJING_MEDIA_IMAGE_SEARCH_MAX_BYTES=8388608

# --- 运行期配图成本控制（ADR-0005 §7/§12）---
# 每会话生图上限（张）：超限只保留占位，不再发起生成。0=不限额。
WENJING_MEDIA_MAX_IMAGES_PER_SESSION=20
# 崩溃后仍愿意重排的在途配图任务年龄上限（秒）。超龄判死而不重排。
WENJING_MEDIA_ASSET_JOB_TTL_SECONDS=900

# --- 语音合成（ADR-0005 §11 / #63）---
# null=不合成（字幕照滚，只是没有配音）；openai=OpenAI 兼容 /audio/speech
WENJING_MEDIA_TTS_PROVIDER=null
WENJING_MEDIA_TTS_BASE_URL=https://api.openai.com/v1
WENJING_MEDIA_TTS_API_KEY=
WENJING_MEDIA_TTS_MODEL=tts-1
# provider 侧默认音色；音色池为空时全场都用它（此时角色不可区分）
WENJING_MEDIA_TTS_DEFAULT_VOICE=alloy
# 音色池（逗号分隔）：角色按**名字哈希**取模分配，同名角色跨会话恒定。
# 池子越大越不容易撞嗓；角色数超过音色数时只能复用。
WENJING_MEDIA_TTS_VOICES=
# 运营钦定的「角色名=音色」覆盖（逗号分隔），优先于池子。
# 例：WENJING_MEDIA_TTS_VOICE_OVERRIDES=母亲=nova,父亲=onyx
WENJING_MEDIA_TTS_VOICE_OVERRIDES=
WENJING_MEDIA_TTS_CONNECT_TIMEOUT=5.0
WENJING_MEDIA_TTS_READ_TIMEOUT=60.0
WENJING_MEDIA_TTS_MAX_BYTES=16777216
WENJING_MEDIA_TTS_MAX_CHARS=4096
# 单句送合成长度上限（tee 的分句器已按标点切过，这里防超长"一句话"）
WENJING_MEDIA_TTS_MAX_SENTENCE_CHARS=200
WENJING_MEDIA_TTS_RESPONSE_FORMAT=mp3

# org 级媒体预算（付费调用前预扣）。0=不限额。
WENJING_MEDIA_ORG_IMAGE_BUDGET=0
# tts 以**字符**计、asr 以**秒**计（与 media_usage.units 同口径）。
WENJING_MEDIA_ORG_TTS_BUDGET=0
WENJING_MEDIA_ORG_ASR_BUDGET=0

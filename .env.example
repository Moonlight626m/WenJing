# 文境生产部署环境变量（docker compose 自动读取根目录 .env）
# 复制为 .env 并按需修改；.env 已被 .gitignore 忽略，请勿提交。

# --- PostgreSQL ---
POSTGRES_USER=wenjing
# 生产必须改为强密码
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=wenjing

# --- 对外 HTTP 端口 / CORS ---
WENJING_HTTP_PORT=80
# 若前端与后端不同源访问，填写浏览器实际访问的源（逗号分隔）
WENJING_CORS_ORIGINS=http://localhost

# --- 账号会话 ---
# 部署在 HTTPS 之后时置 1，登录 Cookie 加 Secure；纯 HTTP 保持 0
WENJING_AUTH_COOKIE_SECURE=0
# seed 测试账号密码（默认 123456，生产请修改）
WENJING_SEED_PASSWORD=123456

# --- LLM ---
WENJING_LLM_PROVIDER=openai
WENJING_LLM_MODEL=gpt-4o-mini
WENJING_LLM_API_KEY=
WENJING_LLM_BASE_URL=

# --- 对象存储（开发 MinIO / 生产 OSS/COS，ADR-0005）---
MINIO_ROOT_USER=wenjing
# 开发默认口令；生产必须改为强密码（须与 WENJING_MEDIA_STORAGE_SECRET_KEY 一致）
MINIO_ROOT_PASSWORD=wenjing123
# 浏览器直取预签名图片的 CORS 允许源（逗号分隔）
MINIO_CORS_ALLOW_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# null=不落盘空实现；s3=S3 兼容。生产改 OSS 时置 s3 并填 endpoint/凭证。
WENJING_MEDIA_STORAGE_PROVIDER=null
# 容器内走内网 endpoint（如 http://minio:9000）；预签名用浏览器可达的 public endpoint
WENJING_MEDIA_STORAGE_ENDPOINT=
WENJING_MEDIA_STORAGE_PUBLIC_ENDPOINT=
WENJING_MEDIA_STORAGE_BUCKET=wenjing-media
WENJING_MEDIA_STORAGE_REGION=
WENJING_MEDIA_STORAGE_ACCESS_KEY=
WENJING_MEDIA_STORAGE_SECRET_KEY=
